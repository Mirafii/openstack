  "equipe-marketing" = {
    domain_name = "marketing.example.lab"
    subnet_cidr = "192.168.101.0/24"
  }
  "equipe-rh" = {
    domain_name = "rh.example.lab"
    subnet_cidr = "192.168.102.0/24"
  }
}
